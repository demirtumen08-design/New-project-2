[Unit]
Description=Growth OS Network/IP Auto Repair
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=growthos
Group=growthos
WorkingDirectory=/opt/growth-os
EnvironmentFile=/etc/growth-os/growth-os.env
ExecStart=/opt/growth-os/venv/bin/python -m src.growth_os.runtime_network --site turkiye-gundemi --publish-site
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/growth-os/config /opt/growth-os/content /opt/growth-os/sites /opt/growth-os/ops /opt/growth-os/reports
