[Unit]
Description=Growth OS Linux Production Operator
After=network-online.target growth-os.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/growth-os
EnvironmentFile=/etc/growth-os/growth-os.env
ExecStart=/opt/growth-os/venv/bin/python -m src.growth_os.production_operator --site turkiye-gundemi --service-user growthos --max-news-age-minutes 12
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/growth-os/config /opt/growth-os/content /opt/growth-os/sites /opt/growth-os/reports
