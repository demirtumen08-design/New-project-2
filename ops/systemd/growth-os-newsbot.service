[Unit]
Description=Growth OS Turkiye Gundemi News Robot
After=network-online.target growth-os.service
Wants=network-online.target

[Service]
Type=oneshot
User=growthos
Group=growthos
WorkingDirectory=/opt/growth-os
EnvironmentFile=/etc/growth-os/growth-os.env
ExecStart=/opt/growth-os/venv/bin/python -m src.growth_os.news_automation --site turkiye-gundemi --limit 90 --max-items 6 --status published --publish-site
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/growth-os/config /opt/growth-os/content /opt/growth-os/sites /opt/growth-os/reports
